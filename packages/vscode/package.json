{
  "name": "web-git-graph",
  "displayName": "Web Git Graph",
  "version": "1.0.0",
  "description": "Read-only Git history graph with deterministic lanes, commit details and revision diffs.",
  "type": "module",
  "license": "MIT",
  "publisher": "kian-zh",
  "icon": "media/icon.png",
  "homepage": "https://github.com/GIS-Info/web-git-graph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIS-Info/web-git-graph.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/GIS-Info/web-git-graph/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "git graph",
    "git history",
    "git log",
    "scm"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Web Git Graph executes read-only Git commands against workspace folders."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Web Git Graph reads local Git repositories from disk."
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:webGitGraph.history"
  ],
  "main": "./dist/extension/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "webGitGraph.open",
        "title": "Open Graph",
        "category": "Web Git Graph",
        "icon": "$(git-branch)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "webGitGraph.open",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Web Git Graph",
      "properties": {
        "webGitGraph.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item that opens the Web Git Graph when the workspace contains a Git repository."
        },
        "webGitGraph.maxDepthOfRepoSearch": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "markdownDescription": "How many directory levels below each workspace folder are searched for Git repositories. `0` only checks the folder itself. `node_modules`, build output and hidden directories are always skipped."
        },
        "webGitGraph.columns": {
          "type": "array",
          "default": [
            "date",
            "author",
            "commit"
          ],
          "items": {
            "type": "string",
            "enum": [
              "date",
              "author",
              "commit"
            ]
          },
          "uniqueItems": true,
          "description": "Columns shown to the right of the graph. The graph and description columns are always shown."
        },
        "webGitGraph.date.format": {
          "type": "string",
          "default": "datetime",
          "enum": [
            "datetime",
            "date",
            "relative"
          ],
          "enumDescriptions": [
            "Date and time, for example 2026/08/03 11:04",
            "Date only, for example 2026/08/03",
            "Relative to now, for example 3 days ago"
          ],
          "description": "How commit dates are rendered in the date column."
        },
        "webGitGraph.date.type": {
          "type": "string",
          "default": "committed",
          "enum": [
            "committed",
            "authored"
          ],
          "enumDescriptions": [
            "The date the commit was committed",
            "The date the commit was authored"
          ],
          "description": "Which of a commit's two dates is shown."
        },
        "webGitGraph.fetchAvatars": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show author avatars from Gravatar. Off by default: enabling it sends a hash of each author's email address to `gravatar.com`."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "pnpm build && pnpm dlx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "~1.95.0",
    "@web-git-graph/node": "workspace:*",
    "@web-git-graph/protocol": "workspace:*",
    "@web-git-graph/web": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "private": true
}
