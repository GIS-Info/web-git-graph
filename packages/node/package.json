{
  "name": "@web-git-graph/node",
  "version": "0.1.0",
  "description": "Read-only local Git backend, HTTP handlers and CLI for Web Git Graph.",
  "type": "module",
  "license": "MIT",
  "author": "kian-zh",
  "homepage": "https://github.com/GIS-Info/web-git-graph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIS-Info/web-git-graph.git",
    "directory": "packages/node"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "web-git-graph": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm build && npm pack --dry-run --cache .npm-cache"
  },
  "dependencies": {
    "@web-git-graph/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
