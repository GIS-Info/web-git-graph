{
  "name": "@web-git-graph/protocol",
  "version": "1.0.6",
  "description": "Transport-neutral Git history protocol (DTOs, JSON Schema, OpenAPI, errors) for Web Git Graph and coding-agent backends.",
  "type": "module",
  "license": "MIT",
  "author": "kian-zh",
  "homepage": "https://github.com/GIS-Info/web-git-graph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIS-Info/web-git-graph.git",
    "directory": "packages/protocol"
  },
  "keywords": [
    "git",
    "git-graph",
    "protocol",
    "openapi",
    "json-schema",
    "dto",
    "coding-agent",
    "read-only"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "require": "./dist/http.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm build && npm pack --dry-run --cache .npm-cache"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
